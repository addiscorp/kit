{
  "name": "@addiscorp/kit",
  "version": "0.2.2",
  "description": "The header, footer, theme and tool-site layout every Addis site shares, in each project's own brand colours.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addiscorp/kit.git"
  },
  "homepage": "https://github.com/addiscorp/kit",
  "sideEffects": [
    "./dist/kit.css",
    "./dist/tool.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit.css": "./dist/kit.css",
    "./tool.css": "./dist/tool.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/kit.css dist/kit.css && cat src/tool/tool.css src/tool/palettes.css > dist/tool.css",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "^26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
